{
  "name": "tarea4-selenium",
  "version": "1.0.0",
  "description": "App CRUD de Tareas con login + suite de pruebas automatizadas Selenium (Tarea 4)",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "dev": "node app/server.js",
    "test": "mocha tests/**/*.test.js --timeout 30000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=reporte-pruebas,quiet=true",
    "test:login": "mocha tests/login.test.js --timeout 30000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=reporte-login",
    "test:tasks": "mocha tests/tasks.test.js --timeout 30000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=reporte-tasks"
  },
  "keywords": [
    "selenium",
    "crud",
    "testing",
    "itla"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ejs": "^3.1.10"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "chromedriver": "^127.0.0",
    "mocha": "^10.7.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.23.0"
  }
}