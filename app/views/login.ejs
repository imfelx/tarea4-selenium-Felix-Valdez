<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Iniciar sesión</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <h1>Iniciar sesión</h1>

    <% if (error) { %>
      <div id="loginError" class="alert alert-error"><%= error %></div>
    <% } %>

    <form id="loginForm" method="POST" action="/login">
      <label for="username">Usuario</label>
      <input type="text" id="username" name="username" maxlength="20" autocomplete="off" />

      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" maxlength="30" autocomplete="off" />

      <button type="submit" id="loginBtn">Entrar</button>
    </form>

    <p class="hint">Usuario de prueba: <b>admin</b> / Contraseña: <b>admin123</b></p>
  </div>
</body>
</html>
